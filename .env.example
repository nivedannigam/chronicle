VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canonical app URL — must match Supabase Auth → Site URL (production only).
# Prevents double Google sign-in when multiple Vercel domains exist.
# VITE_APP_URL=https://chronicle-pa.vercel.app

# Supabase Auth → URL Configuration (Dashboard):
# Site URL: https://chronicle-pa.vercel.app
# Redirect URLs (allowlist):
#   http://localhost:5173/**
#   https://chronicle-pa.vercel.app/**
#   https://chronicle-nivedan.vercel.app/**
# OAuth returns to /auth/callback then redirects to /home

# Database migration apply (server-side only — never commit real values)
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=

# Google Drive OAuth (Supabase edge function secrets — server-side only)
# Use the same OAuth client as Supabase Auth → Providers → Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Document processing / OCR provider
# Options: mock | google | azure
# mock = client-side dev OCR (no document-ocr edge function); use for single-report E2E without Document AI
# google = production via document-ocr edge function (requires GOOGLE_DOCUMENT_AI_* secrets)
VITE_OCR_PROVIDER=mock
VITE_OCR_TIMEOUT_MS=120000
VITE_OCR_MIN_CONFIDENCE=0.5
VITE_OCR_MAX_RETRIES=2
# Storage bucket passed to document-ocr edge function (default: health-reports)
# VITE_OCR_STORAGE_BUCKET=health-reports

# Google Document AI (Supabase edge function secrets — server-side only)
# Required for document-ocr edge function:
# GOOGLE_DOCUMENT_AI_PROJECT_ID=
# GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# GOOGLE_DOCUMENT_AI_LOCATION=us
# GOOGLE_DOCUMENT_AI_IMAGELESS_MODE=true
# GOOGLE_DOCUMENT_AI_MAX_PAGES=30
# Provider page limits (document-ocr orchestration):
#   Google standard: 15 pages per request | imageless: up to 30 pages in one request
#   Reports above 15 pages are split into smaller PDFs automatically (no config needed).
# Preferred: service account JSON (auto-refreshes access token)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Fallback: static bearer token (expires — not recommended for production)
# GOOGLE_DOCUMENT_AI_ACCESS_TOKEN=

# Azure Document Intelligence (server-side only)
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Ask Chronicle AI — routes through Supabase ask-ai edge function (Gemini)
# Requires deployed supabase/functions/ask-ai with GEMINI_API_KEY secret
VITE_AI_PROVIDER=gemini
# VITE_AI_MODEL=gemini-2.5-flash

# Legacy Ask provider settings (optional — production health path uses shared AI platform)
# Options: openai | azure-openai | gemini | claude
# VITE_ASK_PROVIDER=gemini
VITE_ASK_MODEL=gpt-4o-mini
VITE_ASK_TIMEOUT_MS=30000
VITE_ASK_MAX_RETRIES=2
VITE_ASK_CACHE_TTL_MS=300000

# Deprecated — use supabase.functions.invoke("ask-ai") instead of manual proxy URLs
# VITE_ASK_PROXY_URL=
